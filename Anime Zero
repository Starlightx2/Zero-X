    local n = #blob
    local D = table.create and table.create(n) or {}
    for i = 1, n do
        D[i] = (sbyte(blob, i) - seed - i * mul) % 256
    end
    local pos = 1
    local function u8() local v = D[pos]; pos = pos + 1; return v end
    local function varint()
        local shift, result = 0, 0
        while true do
            local b = D[pos]; pos = pos + 1
            result = result + (b % 128) * (2 ^ shift)
            if b < 128 then break end
            shift = shift + 7
        end
        return result
    end
    local function zig()
        local u = varint()
        local v = math.floor(u / 2)
        if u % 2 == 1 then return -v - 1 else return v end
    end
    local function rbytes()
        local len = varint()
        if len == 0 then return "" end
        local parts = table.create and table.create(len) or {}
        for i = 1, len do parts[i] = schar(D[pos + i - 1]) end
        pos = pos + len
        return tconcat(parts)
    end
    local function readProto()
        local p = {}
        p.va = u8() == 1
        p.np = varint(); p.nl = varint(); p.nt = varint()
        local nu = varint(); p.nu = nu
        local ud = table.create and table.create(nu) or {}
        for i = 1, nu do local from = u8(); local idx = varint(); ud[i] = { from, idx } end
        p.ud = ud
        local nk = varint()
        local K = table.create and table.create(nk) or {}
        for i = 1, nk do
            local tag = u8()
            if tag == 0 then K[i] = tonumber(rbytes()) else K[i] = rbytes() end
        end
        p.consts = K
        local nc = varint()
        local code = table.create and table.create(nc) or {}
        for i = 1, nc do
            local op = u8()
            local na = u8()
            local ins = { op }
            for j = 1, na do ins[j + 1] = zig() end
            code[i] = ins
        end
        p.code = code
        local npr = varint()
        local protos = table.create and table.create(npr) or {}
        for i = 1, npr do protos[i] = readProto() end
        p.protos = protos
        return p
    end
    return readProto()
end


