        p.va = u8() == 1
        p.np = varint(); p.nl = varint(); p.nt = varint()
        local nu = varint(); p.nu = nu
        local ud = table.create and table.create(nu) or {}
        for i = 1, nu do local from = u8(); local idx = varint(); ud[i] = { from, idx } end
